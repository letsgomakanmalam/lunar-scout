{
  "name": "lunar-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LUNAR SCOUT: Earth Analog Hunt - NASA Space Apps Challenge 2026, Kuala Lumpur",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "vitest run src/data",
    "typecheck": "tsc --noEmit",
    "qr": "node scripts/qr.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
